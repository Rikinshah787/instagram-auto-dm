# ── Server ──────────────────────────────────────────────────────────────
PORT=3000

# Public HTTPS URL of THIS server (from ngrok / Cloudflare Tunnel / your domain).
# Meta requires HTTPS for OAuth redirects and webhooks. No trailing slash.
# Example: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# Protects the dashboard + admin API. Use a long random string (32+ chars).
ADMIN_TOKEN=change-me-to-a-long-random-string

# ── Instagram app ───────────────────────────────────────────────────────
# Meta App Dashboard -> your app -> Instagram -> "API setup with Instagram login".
# Use the INSTAGRAM app id/secret (NOT the Meta/Facebook app id).
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# Must EXACTLY match a redirect URI you add in the Meta App Dashboard.
# Local (with a tunnel):  https://abcd-1234.ngrok-free.app/auth/callback
# Production:             https://your-domain.com/auth/callback
INSTAGRAM_REDIRECT_URI=https://your-domain.com/auth/callback

# Scopes cover: read profile, send DMs / private replies, manage comments.
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments

# ── Webhooks ────────────────────────────────────────────────────────────
# You invent this string; enter the SAME value in the Meta webhook config.
WEBHOOK_VERIFY_TOKEN=choose-a-strong-verify-token

# Fields to subscribe. 'comments' triggers the flow; 'messages' catches the follow-gate reply.
WEBHOOK_FIELDS=comments,messages

# Leave false. Only set true for local testing WITHOUT signature validation.
WEBHOOK_SKIP_SIGNATURE=false

# ── Advanced (defaults are fine) ────────────────────────────────────────
GRAPH_API_VERSION=v21.0
DATA_DIR=data
LOG_LEVEL=info

# ── Vercel deploy only (leave blank for local / always-on hosting) ──────
# Vercel is serverless, so add an Upstash Redis (KV) integration for storage.
# The integration sets these for you (either naming works):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Protects the /api/cron endpoint that Vercel Cron calls (Vercel sends this).
# CRON_SECRET=
